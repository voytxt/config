// Zed config (https://zed.dev/docs/configuring-zed)

{
  "auto_signature_help": true,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_weight": 500,
  "diagnostics": { "inline": { "enabled": true, "update_debounce_ms": 10 } },
  "disable_ai": true,
  "git_panel": { "tree_view": true },
  "gutter": { "line_numbers": false },
  "indent_guides": { "enabled": false },
  "outline_panel": { "dock": "right", "indent_guides": { "show": "never" } },
  "preview_tabs": { "enabled": false },
  "project_panel": { "indent_guides": { "show": "never" } },
  "show_signature_help_after_edits": true,
  "show_wrap_guides": false,
  "soft_wrap": "editor_width",
  "text_rendering_mode": "grayscale",
  "which_key": { "enabled": true, "delay_ms": 0 },

  // "inlay_hints": { "enabled": true },
  // "sticky_scroll": { "enabled": true },

  // formatting
  // "formatter": [{ "code_action": "source.organizeImports" }, "auto"],
  "format_on_save": "on", // not enabled by default in all langs (i.e. C)
  "tab_size": 2,

  "theme": {
    "mode": "system",
    "light": "Github Light",
    "dark": "Fleet Dark",
  },

  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },

  "languages": {
    // https://github.com/zed-industries/zed/discussions/45239
    "Python": { "language_servers": ["ty", "!basedpyright", "..."] },

    "Rust": { "tab_size": 4 },
    "Typst": { "formatter": { "external": { "command": "typstyle" } } },
  },
}
